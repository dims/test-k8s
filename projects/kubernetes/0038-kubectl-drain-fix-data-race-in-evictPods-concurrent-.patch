From 6d43f9c6cef840777dc5adeca5ae51686f7f281a Mon Sep 17 00:00:00 2001
From: Davanum Srinivas <davanum@gmail.com>
Date: Tue, 5 May 2026 09:34:36 -0400
Subject: [PATCH] kubectl/drain: fix data race in evictPods concurrent Out
 writes

Multiple goroutines spawned by evictPods all write to d.Out and
d.ErrOut concurrently without synchronization. When the caller
provides a non-goroutine-safe writer (e.g. bytes.Buffer in tests),
the race detector flags the concurrent writes.

Add a per-call mutex captured by the goroutine closures to serialize
all fmt.Fprintf calls to d.Out / d.ErrOut within a single evictPods
invocation.

Fixes data race caught by TestDeleteOrEvictWithDryRunServer introduced
in #137543.
---
 staging/src/k8s.io/kubectl/pkg/drain/drain.go | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/staging/src/k8s.io/kubectl/pkg/drain/drain.go b/staging/src/k8s.io/kubectl/pkg/drain/drain.go
index 9f2e36b37ce..c686ef7bb11 100644
--- a/staging/src/k8s.io/kubectl/pkg/drain/drain.go
+++ b/staging/src/k8s.io/kubectl/pkg/drain/drain.go
@@ -21,6 +21,7 @@ import (
 	"fmt"
 	"io"
 	"math"
+	"sync"
 	"time"
 
 	corev1 "k8s.io/api/core/v1"
@@ -271,6 +272,7 @@ func (d *Helper) DeleteOrEvictPods(pods []corev1.Pod) error {
 func (d *Helper) evictPods(pods []corev1.Pod, evictionGroupVersion schema.GroupVersion, getPodFn func(namespace, name string) (*corev1.Pod, error)) error {
 	returnCh := make(chan error, 1)
 	// 0 timeout means infinite, we use MaxInt64 to represent it.
+	var mu sync.Mutex
 	var globalTimeout time.Duration
 	if d.Timeout == 0 {
 		globalTimeout = time.Duration(math.MaxInt64)
@@ -285,14 +287,18 @@ func (d *Helper) evictPods(pods []corev1.Pod, evictionGroupVersion schema.GroupV
 			for {
 				switch d.DryRunStrategy {
 				case cmdutil.DryRunServer:
+					mu.Lock()
 					//nolint:errcheck
 					fmt.Fprintf(d.Out, "evicting pod %s/%s (server dry run)\n", activePod.Namespace, activePod.Name)
+					mu.Unlock()
 				default:
 					if d.OnPodDeletionOrEvictionStarted != nil {
 						d.OnPodDeletionOrEvictionStarted(&activePod, true)
 					}
+					mu.Lock()
 					//nolint:errcheck
 					fmt.Fprintf(d.Out, "evicting pod %s/%s\n", activePod.Namespace, activePod.Name)
+					mu.Unlock()
 				}
 				select {
 				case <-ctx.Done():
@@ -309,8 +315,10 @@ func (d *Helper) evictPods(pods []corev1.Pod, evictionGroupVersion schema.GroupV
 					returnCh <- nil
 					return
 				} else if apierrors.IsTooManyRequests(err) {
+					mu.Lock()
 					//nolint:errcheck
 					fmt.Fprintf(d.ErrOut, "error when evicting pods/%q -n %q (will retry after %v): %v\n", activePod.Name, activePod.Namespace, d.EvictErrorRetryDelay, err)
+					mu.Unlock()
 					time.Sleep(d.EvictErrorRetryDelay)
 				} else if !activePod.ObjectMeta.DeletionTimestamp.IsZero() && apierrors.IsForbidden(err) && apierrors.HasStatusCause(err, corev1.NamespaceTerminatingCause) {
 					// an eviction request in a deleting namespace will throw a forbidden error,
@@ -320,8 +328,10 @@ func (d *Helper) evictPods(pods []corev1.Pod, evictionGroupVersion schema.GroupV
 				} else if apierrors.IsForbidden(err) && apierrors.HasStatusCause(err, corev1.NamespaceTerminatingCause) {
 					// an eviction request in a deleting namespace will throw a forbidden error,
 					// if the pod is not marked deleted, we retry until it is.
+					mu.Lock()
 					//nolint:errcheck
 					fmt.Fprintf(d.ErrOut, "error when evicting pod %q from terminating namespace %q (will retry after %v): %v\n", activePod.Name, activePod.Namespace, d.EvictErrorRetryDelay, err)
+					mu.Unlock()
 					time.Sleep(d.EvictErrorRetryDelay)
 				} else {
 					returnCh <- fmt.Errorf("error when evicting pods/%q -n %q: %v", activePod.Name, activePod.Namespace, err)
-- 
