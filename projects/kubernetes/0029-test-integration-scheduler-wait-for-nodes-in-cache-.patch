From 74a44ca850d28ea266fccccfa0615f7fc3a446ac Mon Sep 17 00:00:00 2001
From: Davanum Srinivas <davanum@gmail.com>
Date: Sat, 2 May 2026 15:10:45 -0400
Subject: [PATCH] test/integration/scheduler: guard both scheduler starts in
 TestSchedulerRestartWithNominatedNode

The first scheduler can also race on fast multi-core runners: node scoring
runs before both nodes appear in the cache, causing pod-a to be scheduled
to node-other (tainted PreferNoSchedule) instead of node-preferred.

Add WaitForNodesInCache before both the first and second scheduler starts.
Previously only the second start was guarded (NVIDIA-dev run 25205734755).
New failure observed in NVIDIA-dev run 25257575513.

Signed-off-by: Davanum Srinivas <davanum@gmail.com>
---
 .../nominated_node_name/nominated_node_name_test.go | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/test/integration/scheduler/nominated_node_name/nominated_node_name_test.go b/test/integration/scheduler/nominated_node_name/nominated_node_name_test.go
index 58eb66b1185..67f34bffb30 100644
--- a/test/integration/scheduler/nominated_node_name/nominated_node_name_test.go
+++ b/test/integration/scheduler/nominated_node_name/nominated_node_name_test.go
@@ -847,6 +847,12 @@ func TestSchedulerRestartWithNominatedNode(t *testing.T) {
 	}
 	mockQueueSort.order[podA.Name] = 1
 
+	// Wait for both nodes to be in the scheduler cache before the first scheduling
+	// cycle fires to avoid a race where node scoring is stale.
+	if err := testutils.WaitForNodesInCache(ctx, testCtx.Scheduler, 2); err != nil {
+		t.Fatalf("Failed waiting for nodes in scheduler cache: %v", err)
+	}
+
 	// Start scheduler
 	go testCtx.Scheduler.Run(testCtx.SchedulerCtx)
 
@@ -874,6 +880,13 @@ func TestSchedulerRestartWithNominatedNode(t *testing.T) {
 	testCtx, teardown := initSched()
 	defer teardown()
 
+	// Wait for both nodes to be reflected in the new scheduler's cache before
+	// starting scheduling, to avoid a race where evaluateNominatedNode fails
+	// with "nodeinfo not found" on the first scheduling cycle.
+	if err := testutils.WaitForNodesInCache(ctx, testCtx.Scheduler, 2); err != nil {
+		t.Fatalf("Failed waiting for nodes in scheduler cache: %v", err)
+	}
+
 	// Start scheduler again
 	go testCtx.Scheduler.Run(testCtx.SchedulerCtx)
 
