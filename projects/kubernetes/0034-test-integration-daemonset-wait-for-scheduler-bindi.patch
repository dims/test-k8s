From 9aab077dad732abdaa8379cc4ac326c31fc807ed Mon Sep 17 00:00:00 2001
From: Davanum Srinivas <davanum@gmail.com>
Date: Sun, 3 May 2026 09:23:50 -0400
Subject: [PATCH] test/integration/daemonset: wait for scheduler binding before
 marking pods ready

validateDaemonSetPodsAndMarkReady polls the informer for non-terminal pods
and immediately returns success when N pods are found, even if spec.nodeName
is still empty (scheduler has not yet bound the pod). DaemonSet pods are
created with NodeAffinity targeting a specific node and bound by the default
scheduler; spec.nodeName is not set at pod-create time.

When the scheduler is slow (loaded CI runner, peak hours), the first informer
poll sees the pod without spec.nodeName, returns success without calling
UpdateStatus, and the pod is never marked Running/Ready. The subsequent
validateDaemonSetStatus then times out waiting for NumberReady==1.

Track pendingScheduling (non-terminal pods with empty spec.nodeName that do
not yet have a PodScheduled=False condition). Require pendingScheduling==0
(in addition to nonTerminatedPods==numberPods) before returning success.

Pods with PodScheduled=False are excluded: those are explicitly unschedulable
(e.g. TestInsufficientCapacityNode's 120M-request pod on a 100M-allocatable
node) and will never receive a nodeName. Including them would cause an
infinite wait for pods that are intentionally never scheduled.

Signed-off-by: Davanum Srinivas <davanum@gmail.com>
---
 test/integration/daemonset/daemonset_test.go | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/test/integration/daemonset/daemonset_test.go b/test/integration/daemonset/daemonset_test.go
index 8ba8b0aa58e..76ab7542f07 100644
--- a/test/integration/daemonset/daemonset_test.go
+++ b/test/integration/daemonset/daemonset_test.go
@@ -282,6 +282,8 @@ func validateDaemonSetPodsAndMarkReady(
 	if err := wait.Poll(time.Second, 60*time.Second, func() (bool, error) {
 		objects := podInformer.GetIndexer().List()
 		nonTerminatedPods := 0
+		// pendingScheduling: pods not yet bound by scheduler and not explicitly unschedulable (PodScheduled=False).
+		pendingScheduling := 0
 
 		for _, object := range objects {
 			pod := object.(*v1.Pod)
@@ -302,6 +304,12 @@ func validateDaemonSetPodsAndMarkReady(
 				continue
 			}
 			nonTerminatedPods++
+			if len(pod.Spec.NodeName) == 0 {
+				_, scheduledCond := podutil.GetPodCondition(&pod.Status, v1.PodScheduled)
+				if scheduledCond == nil || scheduledCond.Status != v1.ConditionFalse {
+					pendingScheduling++
+				}
+			}
 			if !podutil.IsPodReady(pod) && len(pod.Spec.NodeName) != 0 {
 				podCopy := pod.DeepCopy()
 				podCopy.Status = v1.PodStatus{
@@ -315,7 +323,7 @@ func validateDaemonSetPodsAndMarkReady(
 			}
 		}
 
-		return nonTerminatedPods == numberPods, nil
+		return nonTerminatedPods == numberPods && pendingScheduling == 0, nil
 	}); err != nil {
 		t.Fatal(err)
 	}
-- 
