From 67a4ec23e5ae877a0785801183dcd2ff719acc9e Mon Sep 17 00:00:00 2001
From: Davanum Srinivas <davanum@gmail.com>
Date: Thu, 30 Apr 2026 00:17:57 -0700
Subject: [PATCH] test: raise daemonset status poll budgets to 180s for
 StaleControllerConsistency

Signed-off-by: Davanum Srinivas <davanum@gmail.com>
---
 test/integration/daemonset/daemonset_test.go | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/test/integration/daemonset/daemonset_test.go b/test/integration/daemonset/daemonset_test.go
index 5f2551d6405..269b236a84b 100644
--- a/test/integration/daemonset/daemonset_test.go
+++ b/test/integration/daemonset/daemonset_test.go
@@ -478,7 +478,7 @@ func validateDaemonSetStatus(
 	dsName string,
 	expectedNumberReady int32,
 	t *testing.T) {
-	if err := wait.Poll(time.Second, 120*time.Second, func() (bool, error) {
+	if err := wait.Poll(time.Second, 180*time.Second, func() (bool, error) {
 		ds, err := dsClient.Get(context.TODO(), dsName, metav1.GetOptions{})
 		if err != nil {
 			return false, nil // retry on transient apiserver errors under load
@@ -495,7 +495,7 @@ func validateUpdatedNumberScheduled(
 	dsName string,
 	expectedUpdatedNumberScheduled int32,
 	t *testing.T) {
-	if err := wait.PollUntilContextTimeout(ctx, time.Second, 120*time.Second, true, func(ctx context.Context) (bool, error) {
+	if err := wait.PollUntilContextTimeout(ctx, time.Second, 180*time.Second, true, func(ctx context.Context) (bool, error) {
 		ds, err := dsClient.Get(context.TODO(), dsName, metav1.GetOptions{})
 		if err != nil {
 			return false, nil // retry on transient apiserver errors under load
-- 
2.50.1

