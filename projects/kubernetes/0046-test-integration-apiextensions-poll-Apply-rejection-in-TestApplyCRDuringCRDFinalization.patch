From 05d557b0037e6064d5784cec9dccee81faa15842 Mon Sep 17 00:00:00 2001
From: Davanum Srinivas <davanum@gmail.com>
Date: Wed, 13 May 2026 11:53:42 -0400
Subject: [PATCH] test/integration/apiextensions: poll Apply rejection in
 TestApplyCRDuringCRDFinalization

The Terminating condition is observed on the CRD object, but the
apiextensions CR handler reads from a separate informer cache that may
briefly lag behind the apiserver. As a result the Apply call can
succeed during the small window between the wait loop returning and
the CR handler observing the Terminating condition, producing:

    finalization_test.go:210: An error is expected but got nil.

Poll the Apply call until the handler rejects it with the expected
"create not allowed while custom resource definition is terminating"
error instead of asserting once.

Signed-off-by: Davanum Srinivas <davanum@gmail.com>
---
 .../test/integration/finalization_test.go            | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/staging/src/k8s.io/apiextensions-apiserver/test/integration/finalization_test.go b/staging/src/k8s.io/apiextensions-apiserver/test/integration/finalization_test.go
index 2b3d3ecf021..5c7c5eaf11b 100644
--- a/staging/src/k8s.io/apiextensions-apiserver/test/integration/finalization_test.go
+++ b/staging/src/k8s.io/apiextensions-apiserver/test/integration/finalization_test.go
@@ -18,6 +18,7 @@ package integration
 
 import (
 	"context"
+	"strings"
 	"testing"
 	"time"
 
@@ -205,7 +206,14 @@ func TestApplyCRDuringCRDFinalization(t *testing.T) {
 	noxuResourceClient := newNamespacedCustomResourceClient(ns, dynamicClient, noxuDefinition)
 
 	instance := fixtures.NewNoxuInstance(ns, name)
-	_, err = noxuResourceClient.Apply(t.Context(), name, instance, metav1.ApplyOptions{DryRun: []string{"All"}, FieldManager: "manager"})
 	wantErr := `create not allowed while custom resource definition is terminating`
-	require.ErrorContains(t, err, wantErr)
+	// The Terminating condition above is observed on the CRD object, but the apiextensions
+	// CR handler reads from a separate informer cache that may briefly lag. Poll the Apply
+	// until the handler rejects it with the expected error rather than asserting once.
+	var lastErr error
+	err = wait.PollUntilContextTimeout(t.Context(), 100*time.Millisecond, wait.ForeverTestTimeout, true, func(ctx context.Context) (bool, error) {
+		_, lastErr = noxuResourceClient.Apply(ctx, name, instance, metav1.ApplyOptions{DryRun: []string{"All"}, FieldManager: "manager"})
+		return lastErr != nil && strings.Contains(lastErr.Error(), wantErr), nil
+	})
+	require.NoError(t, err, "timed out waiting for Apply to be rejected with %q (last err: %v)", wantErr, lastErr)
 }
