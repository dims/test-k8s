From 2d7ea2f8f01d9f594a7e87ce6ecb5951261be068 Mon Sep 17 00:00:00 2001
From: Davanum Srinivas <davanum@gmail.com>
Date: Fri, 1 May 2026 16:24:08 -0400
Subject: [PATCH] plugin/pkg/admission/podgroup: use direct client for Workload
 lookup

The admission plugin used the informer-backed lister to look up the
referenced Workload. On fast multi-core runners, the lister can lag
behind DeletionTimestamp changes: deleting a Workload sets its
DeletionTimestamp, but the lister may still return the old cached
object without it. This causes the PodGroup admission to pass when
it should reject (referencing a terminating Workload).

Fix: replace the lister-based lookup with a direct API call in Validate,
ensuring fresh state. The informer is still used for WaitForReady.

Also update the unit test to populate the fake client (not just the
informer store) so it reflects the new direct-client code path.
---
 plugin/pkg/admission/podgroup/admission.go      | 14 +++++++-------
 plugin/pkg/admission/podgroup/admission_test.go |  7 ++++++-
 2 files changed, 13 insertions(+), 8 deletions(-)

diff --git a/plugin/pkg/admission/podgroup/admission.go b/plugin/pkg/admission/podgroup/admission.go
index 47c38656de0..994c4d69b7e 100644
--- a/plugin/pkg/admission/podgroup/admission.go
+++ b/plugin/pkg/admission/podgroup/admission.go
@@ -131,14 +131,14 @@ func (p *PodGroupWorkloadExists) Validate(ctx context.Context, a admission.Attri
 	}
 
 	workloadRef := podGroup.Spec.PodGroupTemplateRef.Workload
-	workload, err := p.workloadLister.Workloads(a.GetNamespace()).Get(workloadRef.WorkloadName)
+	// Use a direct API call to get fresh Workload state. The informer-backed lister
+	// can lag behind for DeletionTimestamp changes; using it would allow PodGroups
+	// to reference a terminating Workload on fast multi-core runners.
+	workload, err := p.client.SchedulingV1alpha2().Workloads(
+		a.GetNamespace()).Get(ctx, workloadRef.WorkloadName, metav1.GetOptions{})
 	if apierrors.IsNotFound(err) {
-		workload, err = p.client.SchedulingV1alpha2().Workloads(
-			a.GetNamespace()).Get(ctx, workloadRef.WorkloadName, metav1.GetOptions{})
-		if apierrors.IsNotFound(err) {
-			return admission.NewForbidden(a,
-				fmt.Errorf("PodGroup rejected: Workload %q not found", workloadRef.WorkloadName))
-		}
+		return admission.NewForbidden(a,
+			fmt.Errorf("PodGroup rejected: Workload %q not found", workloadRef.WorkloadName))
 	}
 	if err != nil {
 		return apierrors.NewInternalError(err)
diff --git a/plugin/pkg/admission/podgroup/admission_test.go b/plugin/pkg/admission/podgroup/admission_test.go
index 6631bfe1a72..88d7c6ebb38 100644
--- a/plugin/pkg/admission/podgroup/admission_test.go
+++ b/plugin/pkg/admission/podgroup/admission_test.go
@@ -21,6 +21,7 @@ import (
 
 	schedulingv1alpha2 "k8s.io/api/scheduling/v1alpha2"
 	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/runtime"
 	"k8s.io/apiserver/pkg/admission"
 	"k8s.io/apiserver/pkg/authentication/user"
 	utilfeature "k8s.io/apiserver/pkg/util/feature"
@@ -187,7 +188,11 @@ func TestValidate(t *testing.T) {
 				}
 			}
 			plugin.SetReadyFunc(func() bool { return true })
-			plugin.SetExternalKubeClientSet(fake.NewSimpleClientset())
+			fakeObjs := make([]runtime.Object, len(tc.workloads))
+			for i, w := range tc.workloads {
+				fakeObjs[i] = w
+			}
+			plugin.SetExternalKubeClientSet(fake.NewSimpleClientset(fakeObjs...))
 
 			err := plugin.Validate(ctx, tc.attrs, nil)
 			if tc.wantErr && err == nil {
-- 
