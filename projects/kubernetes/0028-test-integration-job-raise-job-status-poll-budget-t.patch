From 55b603f4c652e55682c30360d394c42b8b029f61 Mon Sep 17 00:00:00 2001
From: Davanum Srinivas <davanum@gmail.com>
Date: Thu, 7 May 2026 11:01:56 -0400
Subject: [PATCH] test/integration/job: raise job status poll budget to 60s for
 slow runners

validateJobsPodsStatusOnly used wait.ForeverTestTimeout (30s) which is
insufficient on 4-vCPU GitHub-hosted runners under load: the job
controller may not process pod failure/replacement within that window.
Double the budget to 2*wait.ForeverTestTimeout (60s) so tests remain
stable on constrained runners.
---
 test/integration/job/job_test.go | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/test/integration/job/job_test.go b/test/integration/job/job_test.go
index c262fb67771..25cd99b1ace 100644
--- a/test/integration/job/job_test.go
+++ b/test/integration/job/job_test.go
@@ -4266,7 +4266,7 @@ type podsByStatus struct {
 
 func validateJobsPodsStatusOnly(ctx context.Context, t testing.TB, clientSet clientset.Interface, jobObj *batchv1.Job, statusType string, desired podsByStatus) {
 	t.Helper()
-	validateJobsPodsStatusOnlyWithTimeout(ctx, t, clientSet, jobObj, statusType, desired, wait.ForeverTestTimeout)
+	validateJobsPodsStatusOnlyWithTimeout(ctx, t, clientSet, jobObj, statusType, desired, 2*wait.ForeverTestTimeout)
 }
 
 func validateJobsPodsStatusOnlyWithTimeout(ctx context.Context, t testing.TB, clientSet clientset.Interface, jobObj *batchv1.Job, statusType string, desired podsByStatus, timeout time.Duration) {
-- 
2.50.1

