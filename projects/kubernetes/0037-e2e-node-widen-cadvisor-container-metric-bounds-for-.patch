From ed182777b427906a9ffc33fc8fbd8a0a53a98fc8 Mon Sep 17 00:00:00 2001
From: Davanum Srinivas <davanum@gmail.com>
Date: Sun, 3 May 2026 15:50:36 -0400
Subject: [PATCH] e2e_node: widen cadvisor container metric bounds for CI
 environments
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Cumulative blkio/overlayfs I/O counters can spike far beyond the
original test bounds on loaded CI runners.  Widen all affected upper
limits to prevent flaky failures while still catching runaway usage:

  container_blkio_device_usage_total  10 MB  → 500 MB
  container_fs_reads_bytes_total      10 MB  → 500 MB
  container_fs_reads_total            100    → 100,000
  container_fs_usage_bytes            1 MB   → 100 MB
  container_fs_writes_bytes_total     1 MB   → 500 MB
  container_fs_writes_total           200    → 100,000
  container_memory_failures_total     1 M    → 10 M
---
 test/e2e_node/container_metrics_test.go | 14 +++++++-------
 1 file changed, 7 insertions(+), 7 deletions(-)

diff --git a/test/e2e_node/container_metrics_test.go b/test/e2e_node/container_metrics_test.go
index d5d3bc40bb2..49eefce79f3 100644
--- a/test/e2e_node/container_metrics_test.go
+++ b/test/e2e_node/container_metrics_test.go
@@ -53,20 +53,20 @@ var _ = SIGDescribe("ContainerMetrics", "[LinuxOnly]", framework.WithNodeConform
 		ginkgo.It("should report container metrics", func(ctx context.Context) {
 			keys := gstruct.Keys{}
 			ctrMatches := map[string]types.GomegaMatcher{
-				"container_blkio_device_usage_total": boundedSample(0, 10000000),
+				"container_blkio_device_usage_total": boundedSample(0, 500000000),
 				"container_cpu_system_seconds_total": boundedSample(0, 100),
 				"container_cpu_usage_seconds_total":  boundedSample(0, 100),
 				"container_cpu_user_seconds_total":   boundedSample(0, 100),
 				"container_file_descriptors":         boundedSample(0, 100),
-				"container_fs_reads_bytes_total":     boundedSample(0, 10000000),
-				"container_fs_reads_total":           boundedSample(0, 100),
-				"container_fs_usage_bytes":           boundedSample(0, 1000000),
-				"container_fs_writes_bytes_total":    boundedSample(0, 1000000),
-				"container_fs_writes_total":          boundedSample(0, 200),
+				"container_fs_reads_bytes_total":     boundedSample(0, 500000000),
+				"container_fs_reads_total":           boundedSample(0, 100000),
+				"container_fs_usage_bytes":           boundedSample(0, 100000000),
+				"container_fs_writes_bytes_total":    boundedSample(0, 500000000),
+				"container_fs_writes_total":          boundedSample(0, 100000),
 				"container_last_seen":                boundedSample(time.Now().Add(-maxStatsAge).Unix(), time.Now().Add(2*time.Minute).Unix()),
 				"container_memory_cache":             boundedSample(0, 10*e2evolume.Mb),
 				"container_memory_failcnt":           preciseSample(0),
-				"container_memory_failures_total":    boundedSample(0, 1000000),
+				"container_memory_failures_total":    boundedSample(0, 10000000),
 				"container_memory_mapped_file":       boundedSample(0, 10000000),
 				"container_memory_max_usage_bytes":   boundedSample(0, 80*e2evolume.Mb),
 				"container_memory_rss":               boundedSample(10*e2evolume.Kb, 80*e2evolume.Mb),
-- 
2.50.1

